{
  "kind": "websocket-session",
  "version": 1,
  "operationId": "subscribeBuildEvents",
  "url": "wss://socket.example.test/v1/events",
  "risk": "write",
  "headers": {
    "X-Client": "kahea-contract"
  },
  "auth": "chat-sandbox",
  "origin": "https://client.example.test",
  "subprotocols": [
    "kahea.events.v1"
  ],
  "limits": {
    "connect_timeout_ms": 5000,
    "action_timeout_ms": 2000,
    "idle_timeout_ms": 5000,
    "close_timeout_ms": 2000,
    "total_timeout_ms": 15000,
    "max_frame_bytes": 1048576,
    "max_message_bytes": 4194304,
    "max_inbound_frames": 64,
    "max_outbound_frames": 64,
    "max_inbound_messages": 32,
    "max_outbound_messages": 32,
    "max_inbound_bytes": 16777216,
    "max_outbound_bytes": 16777216
  },
  "actions": [
    {
      "type": "send-text",
      "text": "{\"type\":\"subscribe\",\"topic\":\"builds\"}"
    },
    {
      "type": "expect-json",
      "pointer": "/type",
      "equals": "subscribed",
      "timeout_ms": 2000
    },
    {
      "type": "ping",
      "payload_base64": "a2FoZWE="
    },
    {
      "type": "expect-pong",
      "payload_base64": "a2FoZWE=",
      "timeout_ms": 2000
    },
    {
      "type": "close",
      "code": 1000,
      "reason": "complete"
    }
  ]
}
